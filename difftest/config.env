# pi-vs-Go differential harness configuration.
# Sourced by run.sh and read by pi/capture.mjs + go/main.go via env.

# The Go port under test. Defaults to the repo this harness lives in — it is
# difftest/ at the root — so a fresh clone needs no configuration. run.sh sets
# HERE before sourcing this file.
PI_GO_REPO="${PI_GO_REPO:-$(cd "$HERE/.." && pwd)}"

# Real pi, published build. Ground truth for anything that shipped.
PI_NPM_VERSION="${PI_NPM_VERSION:-0.99.2}"
PI_NPM_DIR="${PI_NPM_DIR:-$HOME/.cache/pi-npm/$PI_NPM_VERSION}"

# Real pi, TypeScript source. Ground truth for changes ported before they were
# released (the npm build simply does not contain them). Read-only clone.
PI_UPSTREAM_DIR="${PI_UPSTREAM_DIR:-$HOME/.cache/pi-upstream}"
# The sha the Go port is synced to (docs/UPSTREAM.md "TS source fully
# reviewed/ported"). Scenarios with "backend": "src" are captured at this sha.
PI_UPSTREAM_SHA="${PI_UPSTREAM_SHA:-5806068c2}"
