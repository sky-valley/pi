{
  "name": "non-null-assistant-content-openai-completions",
  "note": "Upstream 14b804d80: compat.requiresNonNullAssistantContent replays a tool-call-only assistant turn with content \"\" instead of null, and inserts no assistant message after the tool result. src until the first release that ships 14b804d80, then flip to dist (README rule).",
  "backend": "src",
  "api": "openai-completions",
  "entry": "stream",
  "model": {
    "id": "test-model",
    "name": "Test Model",
    "api": "openai-completions",
    "provider": "test-proxy",
    "baseUrl": "https://proxy.example.com/v1",
    "reasoning": false,
    "input": [
      "text"
    ],
    "cost": {
      "input": 0,
      "output": 0,
      "cacheRead": 0,
      "cacheWrite": 0
    },
    "contextWindow": 128000,
    "maxTokens": 4096,
    "compat": {
      "requiresNonNullAssistantContent": true
    }
  },
  "context": {
    "systemPrompt": "You are a helpful assistant.",
    "messages": [
      {
        "role": "user",
        "content": "Run the command",
        "timestamp": 1
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "toolCall",
            "id": "tool-1",
            "name": "bash",
            "arguments": {
              "command": "true"
            }
          }
        ],
        "api": "openai-completions",
        "provider": "test-proxy",
        "model": "test-model",
        "usage": {
          "input": 10,
          "output": 5,
          "cacheRead": 0,
          "cacheWrite": 0
        },
        "stopReason": "toolUse",
        "timestamp": 2
      },
      {
        "role": "toolResult",
        "toolCallId": "tool-1",
        "toolName": "bash",
        "content": [
          {
            "type": "text",
            "text": "ok"
          }
        ],
        "isError": false,
        "timestamp": 3
      },
      {
        "role": "user",
        "content": "Thanks",
        "timestamp": 4
      }
    ],
    "tools": [
      {
        "name": "bash",
        "description": "Run a command.",
        "parameters": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "options": {
    "apiKey": "test-key",
    "sessionId": "session-non-null",
    "maxTokens": 1024
  }
}
