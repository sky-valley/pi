{
  "name": "copilot-opaque-opencode-go",
  "note": "opencode-go maps a reasoning field to reasoning_content beside the opaque value. dist since the 1.7.0 re-pin: the 1.7.0 build (release fb0fe8235) ships upstream ede8bdca0, which postdated 1.6.1.",
  "backend": "dist",
  "api": "openai-completions",
  "entry": "streamSimple",
  "model": {
    "id": "deepseek-v4-pro",
    "name": "DeepSeek V4 Pro",
    "api": "openai-completions",
    "provider": "opencode-go",
    "baseUrl": "https://opencode.ai/zen/go/v1",
    "reasoning": true,
    "input": [
      "text"
    ],
    "cost": {
      "input": 0.75,
      "output": 3.75,
      "cacheRead": 0.075,
      "cacheWrite": 0
    },
    "contextWindow": 200000,
    "maxTokens": 64000
  },
  "context": {
    "systemPrompt": "You read files.",
    "messages": [
      {
        "role": "user",
        "content": "Read README.md",
        "timestamp": 1
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "thinking",
            "thinking": "t",
            "thinkingSignature": "{\"field\":\"reasoning\",\"reasoning_opaque\":\"OPQ\"}"
          },
          {
            "type": "text",
            "text": "ok"
          }
        ],
        "api": "openai-completions",
        "provider": "opencode-go",
        "model": "deepseek-v4-pro",
        "usage": {
          "input": 10,
          "output": 5,
          "cacheRead": 0,
          "cacheWrite": 0
        },
        "stopReason": "stop",
        "timestamp": 2
      },
      {
        "role": "user",
        "content": "Next.",
        "timestamp": 5
      }
    ],
    "tools": [
      {
        "name": "read",
        "description": "Read a file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "options": {
    "apiKey": "test-key",
    "maxTokens": 1024
  }
}
