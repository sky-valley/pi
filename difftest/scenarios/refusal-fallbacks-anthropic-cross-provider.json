{
  "name": "refusal-fallbacks-anthropic-cross-provider",
  "note": "ed867e909 asymmetry: the provider match this commit added guards the COST lookup only. buildParams still maps EVERY permitted entry onto the wire regardless of provider, so claude-haiku-9 (provider vertex) must appear in fallbacks on both sides even though the model is an anthropic one. Shipped in pi-ai 0.84.3 (release 4e58f324f), so this scenario is backend:\"dist\" — captured against the published build, the stronger ground truth (README rule). Upstream aa47cedce (#12067): a non-strict tool keeps its root additionalProperties; backend src until a release ships it (1.5.2 predates it), so this requires PI_UPSTREAM_SHA >= aa47cedce.",
  "backend": "src",
  "api": "anthropic-messages",
  "entry": "streamSimple",
  "model": {
    "id": "claude-tc-test",
    "name": "Claude TC Test",
    "api": "anthropic-messages",
    "provider": "anthropic",
    "baseUrl": "https://api.anthropic.com",
    "reasoning": true,
    "input": [
      "text"
    ],
    "cost": {
      "input": 3,
      "output": 15,
      "cacheRead": 0.3,
      "cacheWrite": 3.75
    },
    "contextWindow": 200000,
    "maxTokens": 8192,
    "compat": {
      "allowedFallbackModels": [
        {
          "provider": "anthropic",
          "model": "claude-opus-4-8",
          "cost": {
            "input": 5,
            "output": 25,
            "cacheRead": 0.5,
            "cacheWrite": 6.25
          }
        },
        {
          "provider": "vertex",
          "model": "claude-haiku-9",
          "cost": {
            "input": 0.8,
            "output": 4,
            "cacheRead": 0.08,
            "cacheWrite": 1
          }
        }
      ]
    }
  },
  "context": {
    "systemPrompt": "You are a helpful assistant.",
    "messages": [
      {
        "role": "user",
        "content": "Summarize the conversation.",
        "timestamp": 1
      }
    ],
    "tools": [
      {
        "name": "read_file",
        "description": "Read a file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "list_dir",
        "description": "List a directory.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "depth": {
              "type": "number"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "options": {
    "apiKey": "test-key",
    "maxTokens": 1024
  }
}
